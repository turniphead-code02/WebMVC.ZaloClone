@model IEnumerable<ZaloClone.Models.Entities.User>

@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="container mt-4">
    <!-- Tiêu đề dạng Tab chuyển đổi & Nút Thoát về Chat -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-4">
            <h3 class="mb-0 text-primary border-bottom border-primary border-3 pb-1">Quản lý người dùng</h3>
            <h3 class="mb-0">
                <a href="@Url.Action("ManageGroups", "Admin")" class="text-decoration-none text-muted">Quản lý nhóm</a>
            </h3>
        </div>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="bi bi-box-arrow-left"></i> Thoát về Chat
        </a>
    </div>

    <!-- Thống kê tổng quan -->
    <div class="row my-3">
        <div class="col-md-4">
            <div class="alert alert-primary">Tổng số User: <strong>@ViewBag.TotalUsers</strong></div>
        </div>
        <div class="col-md-4">
            <div class="alert alert-success">Tổng số Nhóm: <strong>@ViewBag.TotalGroups</strong></div>
        </div>
        <div class="col-md-4">
            <div class="alert alert-info">Tổng số Tin nhắn: <strong>@ViewBag.TotalMessages</strong></div>
        </div>
    </div>

    <!-- Form Tìm kiếm & Lọc trạng thái User -->
    <form method="get" asp-action="Admin" class="row g-2 mb-3">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" class="form-control" placeholder="Tìm theo tên hoặc email..." value="@ViewBag.SearchTerm" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-select">
                <option value="All" selected="@(ViewBag.StatusFilter == "All")">Tất cả trạng thái</option>
                <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Hoạt động</option>
                <option value="Locked" selected="@(ViewBag.StatusFilter == "Locked")">Đã khóa</option>
                <option value="Deleted" selected="@(ViewBag.StatusFilter == "Deleted")">Đã xóa</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a href="@Url.Action("Admin", "Admin")" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>

    <!-- Bảng danh sách tài khoản -->
    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Email</th>
                <th>Tên hiển thị</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.DisplayName</td>
                    <td>
                        @if (user.IsDeleted)
                        {
                            <span class="badge bg-secondary">Đã xóa</span>
                        }
                        else if (user.IsLocked)
                        {
                            <span class="badge bg-danger">Đã khóa</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                    </td>
                    <td>
                        @if (user.Role != "Admin")
                        {
                            <div class="d-flex gap-1">
                                <form asp-action="ToggleLock" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    @if (!user.IsLocked)
                                    {
                                        <button type="submit" class="btn btn-danger btn-sm">Khóa</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-success btn-sm">Mở khóa</button>
                                    }
                                </form>

                                <form asp-action="ToggleDelete" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    @if (!user.IsDeleted)
                                    {
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa tài khoản này không?');">Xóa</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Khôi phục</button>
                                    }
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Phân trang User -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <div class="small text-muted">Trang @ViewBag.CurrentPage / @ViewBag.TotalPages</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Admin", "Admin", new { searchTerm = ViewBag.SearchTerm, statusFilter = ViewBag.StatusFilter, page = ViewBag.CurrentPage - 1 })">Trước</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Admin", "Admin", new { searchTerm = ViewBag.SearchTerm, statusFilter = ViewBag.StatusFilter, page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Admin", "Admin", new { searchTerm = ViewBag.SearchTerm, statusFilter = ViewBag.StatusFilter, page = ViewBag.CurrentPage + 1 })">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
