@model ZaloClone.Services.Account.ProfileViewModel
@{
	ViewData["Title"] = "Trang cá nhân - " + Model.DisplayName;
	string avatarSrc = string.IsNullOrWhiteSpace(Model.AvatarUrl)
		? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.DisplayName) + "&background=0068ff&color=fff&size=240"
		: Model.AvatarUrl;
	string maxDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
	.zalo-toast-container {
		position: fixed;
		top: 20px;
		right: 20px;
		z-index: 9999;
		display: flex;
		flex-direction: column;
		gap: 10px;
		max-width: 400px;
	}

	.zalo-toast-item {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px 18px;
		border-radius: 12px;
		color: #ffffff;
		font-size: 14.5px;
		font-weight: 500;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
	}

	.zalo-toast-success {
		background: linear-gradient(135deg, #10b981 0%, #059669 100%);
	}

	.zalo-toast-error {
		background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
	}
</style>

<div class="zalo-toast-container">
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="zalo-toast-item zalo-toast-success">
			<i class="bi bi-check-circle-fill fs-5"></i>
			<div class="flex-grow-1">@TempData["SuccessMessage"]</div>
			<button type="button" class="btn-close btn-close-white btn-sm" onclick="this.parentElement.remove()"></button>
		</div>
	}
	@if (TempData["ErrorMessage"] != null)
	{
		<div class="zalo-toast-item zalo-toast-error">
			<i class="bi bi-exclamation-triangle-fill fs-5"></i>
			<div class="flex-grow-1">@TempData["ErrorMessage"]</div>
			<button type="button" class="btn-close btn-close-white btn-sm" onclick="this.parentElement.remove()"></button>
		</div>
	}
</div>

<div class="container py-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h4 class="fw-bold mb-0" style="color:#0068ff;">Trang cá nhân</h4>
		<a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm px-3 fw-semibold" style="background-color:#0068ff;">
			Quay lại màn hình Chat 4 cột
		</a>
	</div>

	<div class="row g-4">
		<div class="col-lg-4">
			<div class="card shadow-sm border-0 rounded-4 text-center p-4">
				<div class="position-relative d-inline-block mx-auto mb-3">
					<img id="avatarPreview"
						 src="@avatarSrc"
						 alt="Avatar của @Model.DisplayName"
						 class="profile-avatar rounded-circle border shadow-sm"
						 style="width: 140px; height: 140px; object-fit: cover;" />
				</div>

				<h5 class="fw-bold mb-1">@Model.DisplayName</h5>
				<p class="text-muted small mb-3">@Model.Email</p>

				<form asp-controller="Profile" asp-action="UpdateAvatar" method="post" enctype="multipart/form-data" class="mt-2">
					@Html.AntiForgeryToken()
					<div class="mb-2">
						<input type="file"
							   name="avatarFile"
							   id="avatarFileInput"
							   accept=".jpg,.jpeg,.png,.webp"
							   class="form-control form-control-sm"
							   required />
					</div>
					<button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold" style="background-color:#0068ff;">
						Cập nhật ảnh đại diện (Avatar)
					</button>
				</form>

				@if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
				{
					<form asp-controller="Profile" asp-action="DeleteAvatar" method="post" class="mt-2">
						@Html.AntiForgeryToken()
						<button type="submit" class="btn btn-outline-danger btn-sm w-100">Xóa ảnh đại diện</button>
					</form>
				}

				<hr class="my-3" />

				<div class="d-grid gap-2">
					<a asp-controller="Profile" asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm">Đổi mật khẩu</a>
					<a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">Mở giao diện Chat 4 cột</a>
					<form asp-controller="Account" asp-action="Logout" method="post">
						@Html.AntiForgeryToken()
						<button type="submit" class="btn btn-danger btn-sm w-100">Đăng xuất</button>
					</form>
				</div>
			</div>
		</div>

		<div class="col-lg-8">
			<div class="card shadow-sm border-0 rounded-4 p-4">
				<h5 class="fw-bold mb-3" style="color:#0068ff;">Thông tin cá nhân</h5>

				<form asp-controller="Profile" asp-action="EditProfile" method="post">
					@Html.AntiForgeryToken()

					<div class="mb-3">
						<label class="form-label fw-semibold">Email đăng nhập</label>
						<input type="email" class="form-control bg-light" value="@Model.Email" readonly />
					</div>

					<div class="row">
						<div class="col-md-7 mb-3">
							<label asp-for="DisplayName" class="form-label fw-semibold">Tên hiển thị <span class="text-danger">*</span></label>
							<input asp-for="DisplayName" class="form-control" required maxlength="100" />
						</div>
						<div class="col-md-5 mb-3">
							<label asp-for="DateOfBirth" class="form-label fw-semibold">Ngày sinh</label>
							<input asp-for="DateOfBirth" type="date" class="form-control" max="@maxDate" />
						</div>
					</div>

					<div class="mb-3">
						<label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
						<input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" maxlength="20" />
					</div>

					<div class="mb-4">
						<label asp-for="Bio" class="form-label fw-semibold">Tiểu sử</label>
						<textarea asp-for="Bio" class="form-control" rows="3" maxlength="255" placeholder="Xin chào, mình là..."></textarea>
					</div>

					<div class="text-end">
						<button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" style="background-color:#0068ff;">
							Lưu thay đổi
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

<script>
	setTimeout(function () {
		document.querySelectorAll('.zalo-toast-item').forEach(function (el) {
			el.style.transition = 'opacity 0.4s ease';
			el.style.opacity = '0';
			setTimeout(function () { el.remove(); }, 400);
		});
	}, 4500);

	setInterval(async function () {
		try {
			const res = await fetch('/Account/CheckSession?t=' + Date.now(), { cache: 'no-store' });
			if (res.ok) {
				const data = await res.json();
				if (data && data.valid === false) {
					window.location.replace('/Account/Login?expired=true');
				}
			} else if (res.status === 401) {
				window.location.replace('/Account/Login?expired=true');
			}
		} catch (e) { }
	}, 2000);
</script>
