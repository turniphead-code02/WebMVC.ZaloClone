@model ZaloClone.Services.Account.ChangePasswordViewModel
@{
	Layout = null;
	ViewData["Title"] = "Đổi mật khẩu - ZaloClone";
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
	<style>
			body {
				background: linear-gradient(180deg, #dcebff 0%, #eef5ff 60%, #e4effe 100%);
				min-height: 100vh;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0;
				padding: 24px 16px;
			}

			.zalo-toast-container {
				position: fixed;
				top: 20px;
				right: 20px;
				z-index: 9999;
				display: flex;
				flex-direction: column;
				gap: 10px;
				max-width: 400px;
			}

			.zalo-toast-item {
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 14px 18px;
				border-radius: 12px;
				color: #ffffff;
				font-size: 14.5px;
				font-weight: 500;
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
			}

			.zalo-toast-success {
				background: linear-gradient(135deg, #10b981 0%, #059669 100%);
			}

			.zalo-toast-error {
				background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
			}
	</style>
</head>
<body>
	<div class="zalo-toast-container">
		@if (TempData["SuccessMessage"] != null)
		{
			<div class="zalo-toast-item zalo-toast-success">
				<i class="bi bi-check-circle-fill fs-5"></i>
				<div class="flex-grow-1">@TempData["SuccessMessage"]</div>
				<button type="button" class="btn-close btn-close-white btn-sm" onclick="this.parentElement.remove()"></button>
			</div>
		}
		@if (TempData["ErrorMessage"] != null)
		{
			<div class="zalo-toast-item zalo-toast-error">
				<i class="bi bi-exclamation-triangle-fill fs-5"></i>
				<div class="flex-grow-1">@TempData["ErrorMessage"]</div>
				<button type="button" class="btn-close btn-close-white btn-sm" onclick="this.parentElement.remove()"></button>
			</div>
		}
	</div>

	<div class="card shadow border-0 rounded-4 p-4" style="width: 100%; max-width: 460px;">
		<div class="d-flex align-items-center justify-content-between mb-3">
			<h5 class="fw-bold mb-0" style="color:#0068ff;">
				<i class="bi bi-shield-lock-fill me-1"></i> Đổi mật khẩu
			</h5>
			<a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-light border">
				<i class="bi bi-arrow-left"></i> Trang cá nhân
			</a>
		</div>

		<p class="text-muted small mb-3">
			Sau khi đổi mật khẩu, tất cả các trình duyệt hoặc thiết bị khác đang đăng nhập tài khoản này sẽ tự động bị đăng xuất để bảo mật (SecurityStamp).
		</p>

		<form asp-controller="Profile" asp-action="ChangePassword" method="post">
			@Html.AntiForgeryToken()
			<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

			<div class="mb-3">
				<label asp-for="CurrentPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
				<input asp-for="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại" />
				<span asp-validation-for="CurrentPassword" class="text-danger small"></span>
			</div>

			<div class="mb-3">
				<label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
				<input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" />
				<span asp-validation-for="NewPassword" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
				<input asp-for="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
				<span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
			</div>

			<div class="d-flex gap-2">
				<a asp-controller="Profile" asp-action="Index" class="btn btn-light border w-50 py-2">Quay lại</a>
				<button type="submit" class="btn btn-primary w-50 py-2 fw-semibold" style="background-color:#0068ff;">
					Cập nhật mật khẩu
				</button>
			</div>
		</form>
	</div>

	<script>
			setTimeout(function () {
				document.querySelectorAll('.zalo-toast-item').forEach(function (el) {
					el.style.transition = 'opacity 0.4s ease';
					el.style.opacity = '0';
					setTimeout(function () { el.remove(); }, 400);
				});
			}, 4500);

			// Kiểm tra phiên đăng nhập (SecurityStamp) mỗi 2 giây: Tự động kick văng ra trang Login ngay khi thiết bị khác đăng nhập hoặc đổi mật khẩu
			setInterval(async function () {
				try {
					const res = await fetch('/Account/CheckSession?t=' + Date.now(), { cache: 'no-store' });
					if (res.ok) {
						const data = await res.json();
						if (data && data.valid === false) {
							window.location.href = '/Account/Login?expired=true';
						}
					} else if (res.status === 401) {
						window.location.href = '/Account/Login?expired=true';
					}
				} catch (err) { }
			}, 2000);
	</script>
</body>
</html>
