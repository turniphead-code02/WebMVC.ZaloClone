@model ZaloClone.Services.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<!-- Đặt file này tại: src/ZaloClone/Views/Profile/ChangePassword.cshtml -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h5 class="fw-bold mb-3" style="color:#0068ff;">Đổi mật khẩu</h5>

                <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
                        <input asp-for="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                        <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="Profile" asp-action="Index" class="btn btn-light border w-50">Quay lại</a>
                        <button type="submit" class="btn btn-primary w-50 fw-semibold" style="background-color:#0068ff;">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
