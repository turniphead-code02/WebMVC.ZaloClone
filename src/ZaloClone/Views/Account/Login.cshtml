@model ZaloClone.Services.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập tài khoản ZaloClone";
    Layout = null;
    var sampleUsers = ViewBag.SampleUsers as List<ZaloClone.Models.Entities.User>;
    var returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(180deg, #dcebff 0%, #eef5ff 60%, #e4effe 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 24px 16px;
        }

        .zalo-brand {
            font-size: 52px;
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.05;
            margin-bottom: 8px;
            text-decoration: none;
            display: inline-flex;
            align-items: baseline;
            user-select: none;
        }

        .zalo-brand .text-zalo {
            color: #0068ff;
        }

        .zalo-brand .text-clone {
            color: #0068ff;
            opacity: 0.85;
            font-weight: 600;
        }

        .zalo-subtitle {
            color: #475569;
            font-size: 15.5px;
            text-align: center;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .account-login-box {
            background: #ffffff;
            width: 100%;
            max-width: 440px;
            border-radius: 14px;
            box-shadow: 0 10px 32px rgba(0, 50, 130, 0.08);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .zalo-card-header {
            padding: 18px 24px;
            text-align: center;
            font-weight: 700;
            font-size: 16.5px;
            color: #111;
            border-bottom: 1px solid #eef0f3;
        }

        .zalo-card-body {
            padding: 28px 36px;
        }

        .zalo-input-group {
            display: flex;
            align-items: center;
            border-bottom: 1px solid #dce1e7;
            padding: 10px 4px;
            margin-bottom: 18px;
            transition: border-color 0.2s;
        }

        .zalo-input-group:focus-within {
            border-bottom-color: #0068ff;
        }

        .zalo-input-icon {
            color: #64748b;
            font-size: 17px;
            width: 28px;
            text-align: center;
            margin-right: 10px;
        }

        .zalo-country-code {
            font-weight: 600;
            font-size: 14.5px;
            color: #334155;
            padding-right: 12px;
            margin-right: 12px;
            border-right: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .zalo-input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 14.5px;
            color: #1e293b;
            background: transparent;
        }

        .zalo-input::placeholder {
            color: #94a3b8;
        }

        .btn-zalo-primary {
            background-color: #0068ff;
            border: none;
            color: #ffffff;
            font-weight: 600;
            font-size: 15px;
            padding: 12px;
            border-radius: 8px;
            width: 100%;
            margin-top: 10px;
            transition: background-color 0.2s;
        }

        .btn-zalo-primary:hover {
            background-color: #0052cc;
            color: #ffffff;
        }

        .zalo-link {
            color: #0068ff;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
        }

        .zalo-link:hover {
            text-decoration: underline;
        }

        .dev-login-box {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>
<body>
    <a href="/Account/Login" class="zalo-brand">
        <span class="text-zalo">Zalo</span><span class="text-clone">Clone</span>
    </a>
    <div class="zalo-subtitle">
        Đăng nhập tài khoản ZaloClone<br />
        để kết nối với ứng dụng Zalo Web
    </div>

    <div class="account-login-box">
        <div class="zalo-card-header">
            Đăng nhập với mật khẩu
        </div>

        <div class="zalo-card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="zalo-input-group">
                    <span class="zalo-input-icon"><i class="bi bi-person-fill"></i></span>
                    <span class="zalo-country-code">+84 <i class="bi bi-caret-down-fill small text-muted ms-1"></i></span>
                    <input asp-for="EmailOrPhone" class="zalo-input" placeholder="Số điện thoại hoặc Email" autofocus />
                </div>
                <span asp-validation-for="EmailOrPhone" class="text-danger small d-block mb-2"></span>

                <div class="zalo-input-group">
                    <span class="zalo-input-icon"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Password" class="zalo-input" placeholder="Mật khẩu" />
                </div>
                <span asp-validation-for="Password" class="text-danger small d-block mb-2"></span>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted">Ghi nhớ đăng nhập</label>
                    </div>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="small text-muted text-decoration-none">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn-zalo-primary">
                    Đăng nhập với mật khẩu
                </button>
            </form>

            <div class="text-center mt-4 pt-2 border-top">
                <span class="text-muted small">Chưa có tài khoản?</span>
                <a asp-controller="Account" asp-action="Register" class="zalo-link ms-1">
                    Đăng ký ngay
                </a>
            </div>
        </div>
    </div>

    @if (sampleUsers != null && sampleUsers.Count > 0)
    {
        <div class="dev-login-box">
            <div class="small fw-bold text-secondary mb-2 text-center">
                ⚡ ĐĂNG NHẬP NHANH (MÔI TRƯỜNG DEV / GIẢNG VIÊN CHẤM ĐỒ ÁN)
            </div>
            <div class="d-grid gap-2">
                @foreach (var user in sampleUsers)
                {
                    <a href="/Account/QuickLogin?userId=@user.Id&returnUrl=@returnUrl" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center">
                        <span><strong>@user.DisplayName</strong> <small class="text-muted">(@user.Email)</small></span>
                        <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-primary")">@user.Role</span>
                    </a>
                }
            </div>
            <div class="text-center text-muted mt-2" style="font-size: 11px;">
                Mật khẩu tất cả tài khoản mẫu: <code>Test@123</code>
            </div>
        </div>
    }
</body>
</html>
