@model ZaloClone.Services.Account.LoginViewModel
@{
	ViewData["Title"] = "Đăng nhập tài khoản ZaloClone";
	Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
	<style>
			body {
				background: linear-gradient(180deg, #dcebff 0%, #eef5ff 60%, #e4effe 100%);
				min-height: 100vh;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				margin: 0;
				padding: 24px 16px;
			}

			.zalo-brand {
				font-size: 56px;
				font-weight: 800;
				letter-spacing: -1.5px;
				line-height: 1.05;
				margin-bottom: 12px;
				text-decoration: none;
				display: inline-flex;
				align-items: baseline;
				user-select: none;
			}

				.zalo-brand .text-zalo {
					color: #0068ff;
				}

				.zalo-brand .text-clone {
					color: #ffffff;
					-webkit-text-stroke: 2.5px #0068ff;
					paint-order: stroke fill;
					text-shadow: -1.5px -1.5px 0 #0068ff, 1.5px -1.5px 0 #0068ff, -1.5px 1.5px 0 #0068ff, 1.5px 1.5px 0 #0068ff;
					margin-left: 2px;
				}

			.zalo-subtitle {
				color: #333;
				font-size: 16px;
				text-align: center;
				line-height: 1.5;
				margin-bottom: 24px;
			}

			.account-login-box {
				background: #ffffff;
				width: 100%;
				max-width: 440px;
				border-radius: 14px;
				box-shadow: 0 10px 32px rgba(0, 50, 130, 0.08);
				overflow: hidden;
			}

			.zalo-card-header {
				padding: 20px 24px;
				text-align: center;
				font-weight: 700;
				font-size: 16.5px;
				color: #111;
				border-bottom: 1px solid #eef0f3;
			}

			.zalo-card-body {
				padding: 30px 40px;
			}

			.zalo-input-group {
				display: flex;
				align-items: center;
				border-bottom: 1px solid #dce1e7;
				padding: 11px 4px;
				margin-bottom: 18px;
			}

				.zalo-input-group:focus-within {
					border-bottom-color: #0068ff;
				}

			.zalo-input-icon {
				color: #555;
				font-size: 17px;
				width: 28px;
				text-align: center;
				margin-right: 10px;
			}

			.zalo-country-code {
				font-weight: 600;
				font-size: 14.5px;
				color: #222;
				padding-right: 14px;
				margin-right: 14px;
				border-right: 1px solid #e2e5ea;
				white-space: nowrap;
			}

			.zalo-input {
				border: none;
				outline: none;
				width: 100%;
				font-size: 14.5px;
				color: #111;
				background: transparent;
			}

			.btn-zalo-primary {
				background-color: #0190f3;
				border: none;
				color: #ffffff;
				font-weight: 600;
				font-size: 15px;
				padding: 12px;
				border-radius: 6px;
				width: 100%;
				margin-top: 10px;
			}

				.btn-zalo-primary:hover {
					background-color: #0068ff;
					color: #ffffff;
				}

			.zalo-link {
				color: #0068ff;
				font-size: 13.5px;
				font-weight: 600;
				text-decoration: none;
			}

			.zalo-toast-container {
				position: fixed;
				top: 20px;
				right: 20px;
				z-index: 9999;
				display: flex;
				flex-direction: column;
				gap: 10px;
				max-width: 420px;
			}

			.zalo-toast-item {
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 14px 18px;
				border-radius: 12px;
				color: #ffffff;
				font-size: 14.5px;
				font-weight: 500;
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
			}

			.zalo-toast-success {
				background: linear-gradient(135deg, #10b981 0%, #059669 100%);
			}

			.zalo-toast-error {
				background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
			}
	</style>
</head>
<body>
	<div class="zalo-toast-container">
		@if (TempData["SuccessMessage"] != null)
		{
			<div class="zalo-toast-item zalo-toast-success">
				<i class="bi bi-check-circle-fill fs-5"></i>
				<div class="flex-grow-1">@TempData["SuccessMessage"]</div>
				<button type="button" class="btn-close btn-close-white btn-sm" onclick="this.parentElement.remove()"></button>
			</div>
		}
		@if (TempData["ErrorMessage"] != null)
		{
			<div class="zalo-toast-item zalo-toast-error">
				<i class="bi bi-exclamation-triangle-fill fs-5"></i>
				<div class="flex-grow-1">@TempData["ErrorMessage"]</div>
				<button type="button" class="btn-close btn-close-white btn-sm" onclick="this.parentElement.remove()"></button>
			</div>
		}
	</div>

	<a asp-controller="Account" asp-action="Login" class="zalo-brand">
		<span class="text-zalo">Zalo</span><span class="text-clone">Clone</span>
	</a>
	<div class="zalo-subtitle">
		Đăng nhập tài khoản ZaloClone<br />
		để kết nối với ứng dụng ZaloClone Web
	</div>

	<div class="account-login-box">
		<div class="zalo-card-header">Đăng nhập với mật khẩu</div>

		<div class="zalo-card-body">
			@if (TempData["SuccessMessage"] != null)
			{
				<div class="alert alert-success d-flex align-items-center gap-2 py-2 small">
					<i class="bi bi-check-circle-fill"></i>
					<span>@TempData["SuccessMessage"]</span>
				</div>
			}
			@if (TempData["ErrorMessage"] != null)
			{
				<div class="alert alert-danger d-flex align-items-center gap-2 py-2 small">
					<i class="bi bi-exclamation-triangle-fill"></i>
					<span>@TempData["ErrorMessage"]</span>
				</div>
			}

			<form asp-controller="Account" asp-action="Login" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" asp-for="ReturnUrl" />
				<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

				<div class="zalo-input-group">
					<span class="zalo-input-icon"><i class="bi bi-phone"></i></span>
					<span class="zalo-country-code">+84</span>
					<input asp-for="EmailOrPhone" class="zalo-input" placeholder="Số điện thoại hoặc Email" autofocus />
				</div>
				<span asp-validation-for="EmailOrPhone" class="text-danger small d-block mb-2"></span>

				<div class="zalo-input-group">
					<span class="zalo-input-icon"><i class="bi bi-lock-fill"></i></span>
					<input asp-for="Password" class="zalo-input" placeholder="Mật khẩu" />
				</div>
				<span asp-validation-for="Password" class="text-danger small d-block mb-2"></span>

				<div class="d-flex justify-content-between align-items-center mb-2">
					<div class="form-check">
						<input asp-for="RememberMe" class="form-check-input" />
						<label asp-for="RememberMe" class="form-check-label small text-muted">Ghi nhớ đăng nhập</label>
					</div>
					<a asp-controller="Account" asp-action="ForgotPassword" class="small text-muted text-decoration-none">Quên mật khẩu?</a>
				</div>



				<button type="submit" class="btn-zalo-primary">Đăng nhập với mật khẩu</button>
			</form>

			<div class="text-center mt-4 pt-2 border-top">
				<span class="text-muted small">Chưa có tài khoản?</span>
				<a asp-controller="Account" asp-action="Register" class="zalo-link ms-1">Đăng ký tài khoản mới</a>
			</div>
		</div>
	</div>

	<script>
			setTimeout(function () {
				document.querySelectorAll('.zalo-toast-item').forEach(function (el) {
					el.style.transition = 'opacity 0.4s ease';
					el.style.opacity = '0';
					setTimeout(function () { el.remove(); }, 400);
				});
			}, 6000);
	</script>
</body>
</html>
