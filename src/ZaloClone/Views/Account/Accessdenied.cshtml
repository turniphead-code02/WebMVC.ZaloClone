@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 rounded-4 p-5 mx-auto" style="max-width: 480px;">
        <h3 class="fw-bold text-danger mb-2">Không có quyền truy cập</h3>
        <p class="text-muted mb-4">Bạn không có quyền truy cập vào trang này hoặc phiên đăng nhập đã thay đổi.</p>
        <div class="d-flex gap-2 justify-content-center">
            <a asp-controller="Profile" asp-action="Index" class="btn btn-primary px-4">Về trang cá nhân</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">Đăng nhập lại</a>
        </div>
    </div>
</div>
