@model ZaloClone.Services.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu Zalo";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(180deg, #e3eeff 0%, #f1f6ff 55%, #e8f0fe 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 24px 16px;
        }
        .zalo-logo {
            font-size: 52px;
            font-weight: 800;
            color: #0068ff;
            letter-spacing: -1.5px;
            line-height: 1;
            margin-bottom: 10px;
            text-decoration: none;
        }
        .zalo-card {
            background: #ffffff;
            width: 100%;
            max-width: 430px;
            border-radius: 12px;
            box-shadow: 0 8px 28px rgba(0, 50, 130, 0.08);
            overflow: hidden;
        }
        .zalo-card-header {
            padding: 18px 24px;
            text-align: center;
            font-weight: 700;
            font-size: 16px;
            color: #111;
            border-bottom: 1px solid #eef0f3;
        }
        .zalo-card-body {
            padding: 26px 34px;
        }
        .zalo-input-group {
            display: flex;
            align-items: center;
            border-bottom: 1px solid #dce1e7;
            padding: 10px 4px;
            margin-bottom: 16px;
        }
        .zalo-input-group:focus-within {
            border-bottom-color: #0068ff;
        }
        .zalo-input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 14.5px;
        }
        .btn-zalo-primary {
            background-color: #0068ff;
            border: none;
            color: #ffffff;
            font-weight: 600;
            font-size: 15px;
            padding: 11px;
            border-radius: 6px;
            width: 100%;
        }
    </style>
</head>
<body>
    <a asp-controller="Account" asp-action="Login" class="zalo-logo">Zalo</a>
    <p class="text-muted mb-4">Khôi phục mật khẩu tài khoản Zalo</p>

    <div class="zalo-card">
        <div class="zalo-card-header">Nhập thông tin tài khoản</div>
        <div class="zalo-card-body">
            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="zalo-input-group">
                    <i class="bi bi-person-Vcard me-2 text-secondary"></i>
                    <input asp-for="EmailOrPhone" class="zalo-input" placeholder="Nhập Số điện thoại hoặc Email" autofocus />
                </div>
                <span asp-validation-for="EmailOrPhone" class="text-danger small d-block mb-3"></span>

                <button type="submit" class="btn-zalo-primary">Tiếp tục nhận mã OTP</button>
            </form>

            <div class="text-center mt-3">
                <a asp-controller="Account" asp-action="Login" class="small text-decoration-none" style="color:#0068ff;">
                    <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</body>
</html>
