@model ZaloClone.Services.Account.ResetPasswordViewModel
@{
	ViewData["Title"] = "Đặt lại mật khẩu ZaloClone";
	Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<style>
			body {
				background: linear-gradient(180deg, #dcebff 0%, #eef5ff 60%, #e4effe 100%);
				min-height: 100vh;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				margin: 0;
				padding: 24px 16px;
			}

			.zalo-brand {
				font-size: 56px;
				font-weight: 800;
				letter-spacing: -1.5px;
				line-height: 1.05;
				margin-bottom: 12px;
				text-decoration: none;
				display: inline-flex;
				align-items: baseline;
				user-select: none;
			}

				.zalo-brand .text-zalo {
					color: #0068ff;
				}

				.zalo-brand .text-clone {
					color: #ffffff;
					-webkit-text-stroke: 2.5px #0068ff;
					paint-order: stroke fill;
					text-shadow: -1.5px -1.5px 0 #0068ff, 1.5px -1.5px 0 #0068ff, -1.5px 1.5px 0 #0068ff, 1.5px 1.5px 0 #0068ff, 0px 2px 6px rgba(0, 104, 255, 0.22);
					margin-left: 2px;
				}

			.zalo-card {
				background: #ffffff;
				width: 100%;
				max-width: 440px;
				border-radius: 14px;
				box-shadow: 0 10px 32px rgba(0, 50, 130, 0.08);
				padding: 28px 34px;
			}
	</style>
</head>
<body>
	<a asp-controller="Account" asp-action="Login" class="zalo-brand">
		<span class="text-zalo">Zalo</span><span class="text-clone">Clone</span>
	</a>
	<p class="text-dark mb-3">Xác nhận OTP &amp; Đặt lại mật khẩu mới</p>

	<div class="zalo-card">
		@if (TempData["DevOtpNotice"] != null)
		{
			<div class="alert alert-info small">@TempData["DevOtpNotice"]</div>
		}

		<form asp-controller="Account" asp-action="ResetPassword" method="post">
			@Html.AntiForgeryToken()
			<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

			<div class="mb-3">
				<label asp-for="Email" class="form-label small fw-semibold">Email tài khoản</label>
				<input asp-for="Email" class="form-control bg-light" readonly />
			</div>

			<div class="mb-3">
				<label asp-for="OtpCode" class="form-label small fw-semibold">Mã xác nhận OTP (6 số)</label>
				<input asp-for="OtpCode" class="form-control" placeholder="Nhập 6 chữ số OTP" maxlength="6" />
				<span asp-validation-for="OtpCode" class="text-danger small"></span>
			</div>

			<div class="mb-3">
				<label asp-for="NewPassword" class="form-label small fw-semibold">Mật khẩu mới</label>
				<input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" />
				<span asp-validation-for="NewPassword" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="ConfirmNewPassword" class="form-label small fw-semibold">Nhập lại mật khẩu mới</label>
				<input asp-for="ConfirmNewPassword" class="form-control" placeholder="Xác nhận mật khẩu" />
				<span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
			</div>

			<button type="submit" class="btn btn-primary w-100 fw-semibold" style="background-color:#0068ff;">
				Đổi mật khẩu
			</button>
		</form>
	</div>
</body>
</html>
