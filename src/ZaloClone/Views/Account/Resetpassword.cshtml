@model ZaloClone.Services.Account.ResetPasswordViewModel
@{
	ViewData["Title"] = "Đặt lại mật khẩu ZaloClone";
	Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
	<style>
			body {
				background: linear-gradient(180deg, #dcebff 0%, #eef5ff 60%, #e4effe 100%);
				min-height: 100vh;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				margin: 0;
				padding: 24px 16px;
			}

			.zalo-brand {
				font-size: 56px;
				font-weight: 800;
				letter-spacing: -1.5px;
				line-height: 1.05;
				margin-bottom: 12px;
				text-decoration: none;
				display: inline-flex;
				align-items: baseline;
				user-select: none;
			}

				.zalo-brand .text-zalo {
					color: #0068ff;
				}

				.zalo-brand .text-clone {
					color: #ffffff;
					-webkit-text-stroke: 2.5px #0068ff;
					paint-order: stroke fill;
					text-shadow: -1.5px -1.5px 0 #0068ff, 1.5px -1.5px 0 #0068ff, -1.5px 1.5px 0 #0068ff, 1.5px 1.5px 0 #0068ff;
					margin-left: 2px;
				}

			.zalo-card {
				background: #ffffff;
				width: 100%;
				max-width: 440px;
				border-radius: 14px;
				box-shadow: 0 10px 32px rgba(0, 50, 130, 0.08);
				padding: 28px 34px;
			}

			.zalo-toast-container {
				position: fixed;
				top: 20px;
				right: 20px;
				z-index: 9999;
				display: flex;
				flex-direction: column;
				gap: 10px;
				max-width: 400px;
			}

			.zalo-toast-item {
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 14px 18px;
				border-radius: 12px;
				color: #ffffff;
				font-size: 14.5px;
				font-weight: 500;
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
			}

			.zalo-toast-success {
				background: linear-gradient(135deg, #10b981 0%, #059669 100%);
			}

			.zalo-toast-error {
				background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
			}
	</style>
</head>
<body>
	<div class="zalo-toast-container">
		@if (TempData["SuccessMessage"] != null)
		{
			<div class="zalo-toast-item zalo-toast-success">
				<i class="bi bi-check-circle-fill fs-5"></i>
				<div class="flex-grow-1">@TempData["SuccessMessage"]</div>
				<button type="button" class="btn-close btn-close-white btn-sm" onclick="this.parentElement.remove()"></button>
			</div>
		}
		@if (TempData["ErrorMessage"] != null)
		{
			<div class="zalo-toast-item zalo-toast-error">
				<i class="bi bi-exclamation-triangle-fill fs-5"></i>
				<div class="flex-grow-1">@TempData["ErrorMessage"]</div>
				<button type="button" class="btn-close btn-close-white btn-sm" onclick="this.parentElement.remove()"></button>
			</div>
		}
	</div>

	<a asp-controller="Account" asp-action="Login" class="zalo-brand">
		<span class="text-zalo">Zalo</span><span class="text-clone">Clone</span>
	</a>
	<p class="text-dark mb-3">Xác nhận OTP &amp; Đặt lại mật khẩu mới</p>

	<div class="zalo-card">
		@if (TempData["DevOtpNotice"] != null)
		{
			<div class="alert alert-info small">@TempData["DevOtpNotice"]</div>
		}

		<form asp-controller="Account" asp-action="ResetPassword" method="post">
			@Html.AntiForgeryToken()
			<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

			<div class="mb-3">
				<label asp-for="Email" class="form-label small fw-semibold">Email tài khoản</label>
				<input asp-for="Email" class="form-control bg-light" readonly />
			</div>

			<div class="mb-3">
				<label asp-for="OtpCode" class="form-label small fw-semibold">Mã xác nhận OTP (6 số)</label>
				<input asp-for="OtpCode" class="form-control" placeholder="Nhập 6 chữ số OTP" maxlength="6" />
				<span asp-validation-for="OtpCode" class="text-danger small"></span>
			</div>

			<div class="mb-3">
				<label asp-for="NewPassword" class="form-label small fw-semibold">Mật khẩu mới</label>
				<input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" />
				<span asp-validation-for="NewPassword" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="ConfirmNewPassword" class="form-label small fw-semibold">Nhập lại mật khẩu mới</label>
				<input asp-for="ConfirmNewPassword" class="form-control" placeholder="Xác nhận mật khẩu" />
				<span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
			</div>

			<button type="submit" class="btn btn-primary w-100 fw-semibold" style="background-color:#0068ff;">
				Đổi mật khẩu
			</button>
		</form>
	</div>

	<script>
			setTimeout(function () {
				document.querySelectorAll('.zalo-toast-item').forEach(function (el) {
					el.style.transition = 'opacity 0.4s ease';
					el.style.opacity = '0';
					setTimeout(function () { el.remove(); }, 400);
				});
			}, 4500);
	</script>
</body>
</html>
